extends Area2D

## ===================================================================
## 危险物（尖刺）
## ===================================================================
## 注意：这里我做的是"通知"，不是"杀死"。
##   尖刺只负责说"我扎到你了"，至于要不要掉命、掉几条，交给玩家自己判断。
##   这样以后你要加"无敌星道具"，根本不用改尖刺这个文件。
##
## 【专业术语】这叫"控制反转 / duck typing（鸭子类型）"：
##   不关心 body 到底是谁，只要它身上有 take_damage 这个方法，就叫它。
## ===================================================================

func _ready() -> void:
	body_entered.connect(_on_body_entered)


func _on_body_entered(body: Node2D) -> void:
	if not body.is_in_group("player"):
		return
	## has_method = "你身上有这个函数吗？" 
	## 有就调用，没有就跳过，保证不会因为模板节点而崩溃。
	if body.has_method("take_damage"):
		## 把自己的坐标传过去，玩家才知道该往哪个方向被弹开
		body.take_damage(global_position)
